# Copy this file to .env and fill in your value(s). Never commit .env.

# Only needed if the API isn't same-origin (e.g. client on Vercel, server on
# Railway). Leave unset for local dev — Vite's proxy handles /api locally.
VITE_API_BASE_URL=

# Same Google OAuth client ID as server/.env's GOOGLE_CLIENT_ID — see that
# file for how to create one. Client IDs are public by design (they identify
# the app, not a secret), so this is safe to ship to the browser. Leave blank
# to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
