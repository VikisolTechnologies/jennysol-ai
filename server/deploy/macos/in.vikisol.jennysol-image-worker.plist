<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	JennySol's local image worker (Z-Image-Turbo by default, via stable-diffusion.cpp) —
	see src/localImageWorker.ts. Same conventions as
	in.vikisol.jennysol-server.plist: no secrets here; LOCAL_IMAGE_WORKER_TOKEN,
	LOCAL_IMAGE_WORKER_HOST/PORT and the model settings come from server/.env.
	-->
	<key>Label</key>
	<string>in.vikisol.jennysol-image-worker</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/node@22/bin/node</string>
		<string>dist/localImageWorker.js</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/jenniferisrael/Developer/jennysol-ai/server</string>

	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/Users/jenniferisrael/Developer/jennysol-ai/server/logs/image-worker.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jenniferisrael/Developer/jennysol-ai/server/logs/image-worker.err.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>NODE_ENV</key>
		<string>production</string>
		<key>PATH</key>
		<string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
