# Copy this file to .env and fill in your key(s). Never commit .env.

# Get a Gemini API key at https://aistudio.google.com/apikey
# Required regardless of LLM_PROVIDER below: image generation always uses Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Which provider(s) chat uses. LLM_PROVIDER_CHAIN is the real setting — a
# comma-separated fallback order, e.g. "gemini,deepseek": if the first
# provider is unconfigured, unreachable, or fails, chat automatically falls
# back to the next one (with a real circuit breaker — a provider that's
# failing repeatedly gets skipped for a cooldown period instead of being
# retried on every single message). LLM_PROVIDER (singular) still works as
# before if you only ever want one provider and no fallback — it's just the
# 1-provider case of the same chain.
LLM_PROVIDER_CHAIN=gemini
LLM_PROVIDER=gemini

# Only needed if LLM_PROVIDER_CHAIN includes deepseek. Get a key at
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Local-first (Ollama) ---
#
# No API key needed — local models never require one. Ollama must be
# reachable from wherever THIS SERVER PROCESS runs, not from your browser:
# 127.0.0.1:11434 only resolves to Ollama when the server and Ollama are on
# the SAME machine. On a cloud host (Railway etc.) that's never true — there
# is no cloud-hosted Ollama to fall back to there. Running local-first means
# running the server itself on the machine Ollama runs on (your Mac now, the
# dedicated Linux box later); only this URL changes when that machine does.
# NEVER expose 11434 to the public internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Fallback only when the model router can't resolve a task-appropriate model
# from the registry (server/src/services/models/modelRegistry.ts) — in normal
# operation the router picks the model per request (general/coding/reasoning).
OLLAMA_MODEL=llama3.2:3b

# Which hardware profile the model registry checks local model memory
# requirements against — see server/src/services/models/hardwareProfile.ts.
# "m1_16gb" | "dedicated_rtx5060ti_16gb" | leave blank to auto-detect from
# the actual machine (platform/arch/RAM) this process is running on.
LOCAL_HARDWARE_PROFILE=

# "local" runs the whole Agent Runtime on this machine, alongside Ollama —
# what local-first development/testing means. Its one real effect today:
# when LLM_PROVIDER_CHAIN/LLM_PROVIDER aren't set, the default chain becomes
# "ollama,gemini,deepseek" instead of just "gemini" (see modelRouter.ts's
# defaultChainFor). "cloud" is what's actually deployed on Railway (no local
# Ollama reachable there) and keeps today's plain gemini-first default.
DEPLOYMENT_MODE=cloud

# Used to build links in verification/password-reset emails. Set this to
# wherever the client is actually deployed (e.g. https://jennysol.vikisol.in).
FRONTEND_URL=http://localhost:5173

# --- Latency / resilience tuning (all optional — sane defaults if unset) ---
#
# How many of the most recent raw messages get sent to the model verbatim;
# everything older is folded into a rolling background-generated summary
# instead, so prompt size (and cost/latency) stays bounded no matter how long
# a conversation gets. See JENNY_IMPLEMENTATION_STATUS.md section 43.
CONTEXT_RECENT_WINDOW=12
# Re-summarize once the unsummarized gap grows by this many messages — not on
# every message past the window, which would double the model calls per turn.
CONTEXT_SUMMARY_BATCH=5
# How long a single provider attempt may produce zero output before the
# router gives up on it and moves to the next one in the chain (or fails, if
# it's the only one configured). Bounds worst-case latency; does not affect
# an attempt that's already actively streaming.
LLM_FIRST_TOKEN_TIMEOUT_MS=15000
# If true, and a second provider is configured, a request that hasn't
# produced a first token after LLM_HEDGE_DELAY_MS also starts that second
# provider concurrently — whichever answers first wins. Off by default: it
# only does anything once 2+ providers are actually configured, and racing
# two providers has a real cost (see the "known limitation" note in section
# 43 about a hedge winner that fails mid-stream).
LLM_HEDGE_ENABLED=false
LLM_HEDGE_DELAY_MS=4000
# Local (Ollama) gets its own, much tighter first-token budget than either
# cloud tier — safe because the router measures ANY provider activity
# (reasoning-trace tokens included, not just real answer content) here, not
# just real content; confirmed live that a locally-run model's first
# activity arrives in ~300ms whether warm or "thinking." See
# JENNY_MODEL_FLEET.md / modelRouter.ts's firstTokenTimeoutMs().
LLM_LOCAL_FIRST_TOKEN_TIMEOUT_MS=2500
# SSE keepalive interval during idle generation gaps, so an intermediary
# (proxy, mobile carrier NAT) doesn't mistake a quiet-but-alive connection
# for a dead one and silently drop it.
SSE_HEARTBEAT_MS=10000

# --- Local-model keep-warm / shadow traffic (all optional — no-ops unless
# Ollama is actually in the active LLM_PROVIDER_CHAIN) ---
#
# Pings the real registry-selected general model on this interval so it
# stays resident in Ollama's memory — shorter than Ollama's own ~5min
# default unload window. See keepWarm.ts.
OLLAMA_KEEP_WARM_ENABLED=true
OLLAMA_KEEP_WARM_INTERVAL_MS=240000
# How long since last real use before providers/ollama.ts's wasModelWarm()
# calls a model "cold" again — should stay shorter than Ollama's own actual
# unload timeout.
OLLAMA_WARM_WINDOW_MS=300000
# Sends a small, configurable share of real requests NOT already served by
# Ollama to it in parallel too, purely to collect real latency/error-rate
# evidence — result always discarded, never shown to the user or used to
# answer anything. See shadowTraffic.ts. Keep this low; it's for judgment,
# not for real traffic.
SHADOW_TRAFFIC_ENABLED=true
SHADOW_TRAFFIC_SAMPLE_RATE=0.05

# "Sign in with Google" — get one at https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth client ID -> Application type: Web application.
# Under "Authorized JavaScript origins" add both http://localhost:5173 (dev) and
# your real deployed URL (e.g. https://jennysol-ai.vercel.app). No redirect URI or
# client secret needed — this uses Google Identity Services' token-based sign-in,
# verified server-side. The same value also goes in client/.env as
# VITE_GOOGLE_CLIENT_ID (client IDs are public by design, safe to ship to the browser).
# Leave blank to disable the Google sign-in button.
GOOGLE_CLIENT_ID=

PORT=8787
# Leave unset on Railway (defaults to 0.0.0.0 — required for Railway's own
# edge proxy to reach this container). On a machine fronted by a local
# reverse proxy/tunnel on the same box (this Mac, eventually), set
# HOST=127.0.0.1 so the server is only reachable from that proxy, not from
# every device on the local network — see JENNY_MAC_PRODUCTION_REQUIREMENTS.md.
HOST=

# M2 (product identity/security, see docs/architecture/ADR-003 and
# PROJECT-PROGRESS.md): the shared secret JennySol verifies a given product's
# service tokens against. One variable per connected product, named
# SERVICE_TOKEN_SECRET_<PRODUCT>, e.g. for Arena once it exists (M5):
#   SERVICE_TOKEN_SECRET_ARENA=<a long random string, matching what Arena's
#   own AgentServiceTokenIssuer signs with>
# No product is connected yet as of M2 — this section exists so the pattern
# is documented before the first real one (Arena) is added. Never used to
# authenticate a JennySol user directly; only to verify a token minted by a
# *different* product on that product's own user's behalf.
