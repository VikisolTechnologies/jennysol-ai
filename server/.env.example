# Copy this file to .env and fill in your key(s). Never commit .env.

# Get a Gemini API key at https://aistudio.google.com/apikey
# Required regardless of LLM_PROVIDER below: image generation always uses Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Which provider chat uses: "gemini" (default), "deepseek", or "ollama".
LLM_PROVIDER=gemini

# Only needed if LLM_PROVIDER=deepseek. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Only needed if LLM_PROVIDER=ollama. Ollama must be reachable from wherever
# THIS SERVER runs — on your own machine in local dev that's the default below;
# on a cloud host (Railway etc.) there is no cloud-hosted Ollama, you'd need to
# run and expose one yourself. Pull the model first: `ollama pull llama3.2`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

PORT=8787
